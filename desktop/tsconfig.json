{
    "extends": "./.hutch/devkit/tsconfig.json",
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": ["ES2021", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
            "electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
            "electrobun/main": ["./.hutch/devkit/api/sdks/main/index.ts"],
            "electrobun/view": ["./.hutch/devkit/api/browser/index.ts"]
        },
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["src", "scripts", "*.ts"],
    "exclude": ["node_modules", "dist", "build", "../../package/dist"]
}
