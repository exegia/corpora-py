{
	"name": "electrobun-react-tailwind-vite",
	"version": "1.0.0",
	"description": "Electrobun app with React, Tailwind CSS, and Vite HMR",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build:canary": "vite build && electrobun build --env=canary"
	},
	"dependencies": {
		"@gravity-ui/icons": "^2.18.0",
		"@heroui/react": "^3.2.1",
		"@heroui/styles": "^3.2.1",
		"@iconify/react": "^6.0.2",
		"@icons-pack/react-simple-icons": "^13.13.0",
		"@tailwindcss/vite": "^4.3.1",
		"bun_python": "^0.1.10",
		"electrobun": "1.18.1",
		"lucide-react": "^1.21.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"postcss": "^8.4.49",
		"tailwindcss": "^4.3.1",
		"typescript": "^5.7.2",
		"vite": "^6.0.3"
	}
}
