{
	"name": "electrobun-react-tailwind-vite",
	"version": "1.0.0",
	"description": "Electrobun app with React, Tailwind CSS, and Vite HMR",
	"scripts": {
		"start": "dotenvx run -fk ./../../.env.keys -f ./../../.env.development -- vite build",
		"dev": "dotenvx run -fk ./../../.env.keys -f ./../../.env.development -- electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build:canary": "vite build && electrobun build --env=canary",
		"build:python": "bun scripts/build-embedded-python.ts",
		"build:python:clean": "bun scripts/build-embedded-python.ts --clean"
	},
	"dependencies": {
		"@dotenvx/dotenvx": "latest",
		"@gravity-ui/icons": "^2.18.0",
		"@heroui/react": "^3.2.1",
		"@heroui/styles": "^3.2.1",
		"@iconify/react": "^6.0.2",
		"@icons-pack/react-simple-icons": "^13.13.0",
		"@tailwindcss/vite": "^4.3.1",
		"bun_python": "^0.1.10",
		"bunpy": "^0.3.3",
		"electrobun": "1.18.4-beta.6",
		"lucide-react": "^1.21.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"autoprefixer": "^10.5.2",
		"concurrently": "^10.0.3",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"vite": "^8.1.0"
	}
}
