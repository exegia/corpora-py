<?xml version='1.0' encoding='utf-8'?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes" ns="">
  <include href="upstream/usx.rng">
    <start>
      <choice>
        <ref name="Document" />
        <ref name="Collection" />
      </choice>
    </start>
    <define name="BookIntroduction">
      <choice>
        <element name="para">
          <ref name="PresentationAttributes" />
          <attribute name="style">
            <ref name="BookIntroduction.para.style.enum" />
          </attribute>
          <zeroOrMore>
            <choice>
              <ref name="Reference" />
              <ref name="Footnote" />
              <ref name="CrossReference" />
              <ref name="Char" />
              <ref name="IntroChar" />
              <ref name="Milestone" />
              <ref name="Figure" />
              <text />
              <ref name="Boundary" />
              <ref name="Mark" />
            </choice>
          </zeroOrMore>
        </element>
        <ref name="Table" />
      </choice>
    </define>
    <define name="BookIntroductionEndTitles">
      <element name="para">
        <ref name="PresentationAttributes" />
        <attribute name="style">
          <ref name="BookIntroductionEndTitles.para.style.enum" />
        </attribute>
        <zeroOrMore>
          <choice>
            <ref name="Footnote" />
            <ref name="CrossReference" />
            <ref name="Char" />
            <ref name="Milestone" />
            <ref name="Break" />
            <text />
            <ref name="Boundary" />
            <ref name="Mark" />
          </choice>
        </zeroOrMore>
      </element>
    </define>
    <define name="ChapterContent">
      <choice>
        <ref name="Chapter" />
        <ref name="Para" />
        <ref name="List" />
        <ref name="Table" />
        <ref name="Footnote" />
        <ref name="CrossReference" />
        <ref name="Sidebar" />
        <ref name="Boundary" />
        <ref name="Mark" />
      </choice>
    </define>
    <define name="Para">
      <element name="para">
        <ref name="PresentationAttributes" />
        <attribute name="style">
          <ref name="Para.para.style.enum" />
        </attribute>
        <optional>
          <attribute name="vid">
            <ref name="NonemptyText" />
          </attribute>
        </optional>
        <oneOrMore>
          <choice>
            <ref name="Reference" />
            <ref name="Footnote" />
            <ref name="CrossReference" />
            <ref name="Char" />
            <ref name="Milestone" />
            <ref name="Figure" />
            <ref name="Verse" />
            <ref name="Break" />
            <text />
            <ref name="Boundary" />
            <ref name="Mark" />
          </choice>
        </oneOrMore>
      </element>
    </define>
    <define name="List">
      <element name="para">
        <ref name="PresentationAttributes" />
        <attribute name="style">
          <ref name="List.para.style.enum" />
        </attribute>
        <optional>
          <attribute name="vid">
            <ref name="NonemptyText" />
          </attribute>
        </optional>
        <oneOrMore>
          <choice>
            <ref name="Reference" />
            <ref name="Footnote" />
            <ref name="CrossReference" />
            <ref name="Char" />
            <ref name="ListChar" />
            <ref name="Milestone" />
            <ref name="Figure" />
            <ref name="Verse" />
            <ref name="Break" />
            <text />
            <ref name="Boundary" />
            <ref name="Mark" />
          </choice>
        </oneOrMore>
      </element>
    </define>
    <define name="Table">
      <element name="table">
        <ref name="PresentationAttributes" />
        <optional>
          <attribute name="vid">
            <ref name="NonemptyText" />
          </attribute>
        </optional>
        <oneOrMore>
          <element name="row">
            <ref name="PresentationAttributes" />
            <attribute name="style">
              <value>tr</value>
            </attribute>
            <oneOrMore>
              <choice>
                <ref name="Verse" />
                <ref name="TableContent" />
              </choice>
            </oneOrMore>
          </element>
        </oneOrMore>
      </element>
    </define>
    <define name="TableContent">
      <element name="cell">
        <ref name="PresentationAttributes" />
        <attribute name="style">
          <data type="string">
            <param name="pattern">t[hc][rc]?\d+</param>
          </data>
        </attribute>
        <attribute name="align">
          <ref name="cell.align.enum" />
        </attribute>
        <optional>
          <attribute name="colspan">
            <data type="integer" />
          </attribute>
        </optional>
        <zeroOrMore>
          <choice>
            <ref name="Footnote" />
            <ref name="CrossReference" />
            <ref name="Char" />
            <ref name="Milestone" />
            <ref name="Figure" />
            <ref name="Verse" />
            <ref name="Break" />
            <text />
            <ref name="Boundary" />
            <ref name="Mark" />
          </choice>
        </zeroOrMore>
      </element>
    </define>
    <define name="IntroChar">
      <element name="char">
        <ref name="PresentationAttributes" />
        <group>
          <attribute name="style">
            <ref name="IntroChar.char.style.enum" />
          </attribute>
          <optional>
            <ref name="char.closed" />
          </optional>
          <optional>
            <ref name="OtherAttributes" />
          </optional>
          <text />
          <zeroOrMore>
            <choice>
              <ref name="Reference" />
              <ref name="Char" />
              <ref name="IntroChar" />
              <ref name="Milestone" />
              <ref name="Footnote" />
              <ref name="Break" />
              <text />
              <ref name="Boundary" />
              <ref name="Mark" />
            </choice>
          </zeroOrMore>
        </group>
      </element>
    </define>
    <define name="Char">
      <choice>
        <element name="char">
          <ref name="PresentationAttributes" />
          <group>
            <attribute name="style">
              <ref name="Char.char.style.enum" />
            </attribute>
            <optional>
              <ref name="char.link" />
            </optional>
            <optional>
              <ref name="char.closed" />
            </optional>
            <optional>
              <ref name="OtherAttributes" />
            </optional>
            <text />
            <zeroOrMore>
              <choice>
                <ref name="Reference" />
                <ref name="Char" />
                <ref name="Milestone" />
                <ref name="Footnote" />
                <ref name="Break" />
                <text />
                <ref name="Boundary" />
                <ref name="Mark" />
              </choice>
            </zeroOrMore>
          </group>
        </element>
        <ref name="CharWithAttrib.enum" />
      </choice>
    </define>
    <define name="ListChar">
      <element name="char">
        <ref name="PresentationAttributes" />
        <group>
          <attribute name="style">
            <ref name="ListChar.char.style.enum" />
          </attribute>
          <optional>
            <ref name="char.link" />
          </optional>
          <optional>
            <ref name="char.closed" />
          </optional>
          <optional>
            <ref name="OtherAttributes" />
          </optional>
          <text />
          <zeroOrMore>
            <choice>
              <ref name="Reference" />
              <ref name="Char" />
              <ref name="Milestone" />
              <ref name="Footnote" />
              <ref name="Break" />
              <text />
              <ref name="Boundary" />
              <ref name="Mark" />
            </choice>
          </zeroOrMore>
        </group>
      </element>
    </define>
    <define name="CharWithAttrib.char.style.w">
      <element name="char">
        <ref name="PresentationAttributes" />
        <group>
          <attribute name="style">
            <value>w</value>
          </attribute>
          <optional>
            <ref name="char.link" />
          </optional>
          <optional>
            <ref name="char.closed" />
          </optional>
          <optional>
            <attribute name="lemma">
              <data type="string">
                <param name="minLength">1</param>
              </data>
            </attribute>
          </optional>
          <optional>
            <attribute name="strong">
              <data type="string">
                <param name="pattern">([HG]\d{4,5}(:[a-z])?,?)+</param>
              </data>
            </attribute>
          </optional>
          <optional>
            <attribute name="srcloc">
              <data type="string">
                <param name="pattern">[a-z]{3,5}\d?:\d+\.\d+\.\d+\.\d+</param>
              </data>
            </attribute>
          </optional>
          <optional>
            <ref name="OtherAttributes" />
          </optional>
          <text />
          <zeroOrMore>
            <choice>
              <ref name="Reference" />
              <ref name="Char" />
              <ref name="Milestone" />
              <ref name="Footnote" />
              <ref name="Break" />
              <text />
              <ref name="Boundary" />
              <ref name="Mark" />
            </choice>
          </zeroOrMore>
        </group>
      </element>
    </define>
    <define name="CharWithAttrib.char.style.rb">
      <element name="char">
        <ref name="PresentationAttributes" />
        <group>
          <attribute name="style">
            <value>rb</value>
          </attribute>
          <optional>
            <ref name="char.link" />
          </optional>
          <optional>
            <ref name="char.closed" />
          </optional>
          <optional>
            <attribute name="gloss">
              <data type="string">
                <param name="minLength">1</param>
              </data>
            </attribute>
          </optional>
          <optional>
            <ref name="OtherAttributes" />
          </optional>
          <text />
          <zeroOrMore>
            <choice>
              <ref name="Reference" />
              <ref name="Char" />
              <ref name="Milestone" />
              <ref name="Footnote" />
              <ref name="Break" />
              <text />
              <ref name="Boundary" />
              <ref name="Mark" />
            </choice>
          </zeroOrMore>
        </group>
      </element>
    </define>
    <define name="char.link">
      <optional>
        <attribute name="link-href">
          <ref name="NonemptyText" />
        </attribute>
      </optional>
      <optional>
        <attribute name="link-title">
          <data type="string" />
        </attribute>
      </optional>
      <optional>
        <attribute name="link-id">
          <ref name="NonemptyText" />
        </attribute>
      </optional>
    </define>
    <define name="Milestone">
      <choice>
        <element name="ms">
          <attribute name="style">
            <ref name="Milestone.ms.style.enum" />
          </attribute>
          <optional>
            <attribute name="sid">
              <ref name="NonemptyText" />
            </attribute>
          </optional>
          <optional>
            <attribute name="eid">
              <ref name="NonemptyText" />
            </attribute>
          </optional>
          <empty />
        </element>
        <ref name="MilestoneWithAttrib.enum" />
      </choice>
    </define>
    <define name="MilestoneWithAttrib.ms.style.qt">
      <element name="ms">
        <attribute name="style">
          <data type="string">
            <param name="pattern">qt[1-5]?(\-[se])?</param>
          </data>
        </attribute>
        <optional>
          <attribute name="sid">
            <ref name="NonemptyText" />
          </attribute>
        </optional>
        <optional>
          <attribute name="eid">
            <ref name="NonemptyText" />
          </attribute>
        </optional>
        <optional>
          <attribute name="who">
            <data type="string">
              <param name="minLength">2</param>
            </data>
          </attribute>
        </optional>
        <empty />
      </element>
    </define>
    <define name="ChapterStart">
      <element name="chapter">
        <ref name="PresentationAttributes" />
        <interleave>
          <attribute name="number">
            <ref name="NonemptyText" />
          </attribute>
          <attribute name="style">
            <value>c</value>
          </attribute>
          <attribute name="sid">
            <ref name="NonemptyText" />
          </attribute>
          <optional>
            <attribute name="altnumber">
              <ref name="NonemptyText" />
            </attribute>
          </optional>
          <optional>
            <attribute name="pubnumber">
              <data type="string">
                <param name="minLength">1</param>
              </data>
            </attribute>
          </optional>
          <empty />
        </interleave>
      </element>
    </define>
    <define name="ChapterEnd">
      <element name="chapter">
        <ref name="PresentationAttributes" />
        <attribute name="eid">
          <ref name="NonemptyText" />
        </attribute>
        <empty />
      </element>
    </define>
    <define name="VerseStart">
      <element name="verse">
        <ref name="PresentationAttributes" />
        <attribute name="number">
          <ref name="NonemptyText" />
        </attribute>
        <attribute name="style">
          <value>v</value>
        </attribute>
        <optional>
          <attribute name="altnumber">
            <ref name="NonemptyText" />
          </attribute>
        </optional>
        <optional>
          <attribute name="pubnumber">
            <data type="string">
              <param name="minLength">1</param>
            </data>
          </attribute>
        </optional>
        <attribute name="sid">
          <ref name="NonemptyText" />
        </attribute>
        <empty />
      </element>
    </define>
    <define name="VerseEnd">
      <element name="verse">
        <ref name="PresentationAttributes" />
        <attribute name="eid">
          <ref name="NonemptyText" />
        </attribute>
        <empty />
      </element>
    </define>
    <define name="Figure">
      <element name="figure">
        <ref name="PresentationAttributes" />
        <group>
          <attribute name="style" />
          <optional>
            <attribute name="alt" />
          </optional>
          <attribute name="file" />
          <optional>
            <attribute name="size" />
          </optional>
          <optional>
            <attribute name="loc">
              <ref name="NonemptyText" />
            </attribute>
          </optional>
          <optional>
            <attribute name="copy" />
          </optional>
          <optional>
            <attribute name="ref" />
          </optional>
          <optional>
            <text />
          </optional>
        </group>
      </element>
    </define>
    <define name="Reference">
      <element name="ref">
        <ref name="PresentationAttributes" />
        <attribute name="loc">
          <ref name="NonemptyText" />
        </attribute>
        <optional>
          <text />
        </optional>
      </element>
    </define>
    <define name="BookHeaders">
      <element name="para">
        <ref name="PresentationAttributes" />
        <attribute name="style">
          <ref name="BookHeaders.para.style.enum" />
        </attribute>
        <optional>
          <text />
        </optional>
      </element>
    </define>
    <define name="BookTitles">
      <element name="para">
        <ref name="PresentationAttributes" />
        <attribute name="style">
          <ref name="BookTitles.para.style.enum" />
        </attribute>
        <zeroOrMore>
          <choice>
            <ref name="Footnote" />
            <ref name="CrossReference" />
            <ref name="Char" />
            <ref name="Break" />
            <text />
          </choice>
        </zeroOrMore>
      </element>
    </define>
    <define name="BookChapterLabel">
      <element name="para">
        <ref name="PresentationAttributes" />
        <attribute name="style">
          <value>cl</value>
        </attribute>
        <text />
      </element>
    </define>
    <define name="Footnote">
      <element name="note">
        <ref name="PresentationAttributes" />
        <attribute name="style">
          <choice>
            <value>f</value>
            <value>fe</value>
            <value>ef</value>
          </choice>
        </attribute>
        <attribute name="caller" />
        <optional>
          <attribute name="category" />
        </optional>
        <oneOrMore>
          <choice>
            <ref name="FootnoteChar" />
            <text />
          </choice>
        </oneOrMore>
      </element>
    </define>
    <define name="FootnoteChar">
      <element name="char">
        <ref name="PresentationAttributes" />
        <attribute name="style">
          <ref name="FootnoteChar.char.style.enum" />
        </attribute>
        <optional>
          <ref name="char.link" />
        </optional>
        <optional>
          <ref name="char.closed" />
        </optional>
        <oneOrMore>
          <choice>
            <ref name="Char" />
            <ref name="FootnoteChar" />
            <ref name="FootnoteVerse" />
            <ref name="Reference" />
            <text />
          </choice>
        </oneOrMore>
      </element>
    </define>
    <define name="FootnoteVerse">
      <element name="char">
        <ref name="PresentationAttributes" />
        <attribute name="style">
          <value>fv</value>
        </attribute>
        <text />
      </element>
    </define>
    <define name="CrossReference">
      <element name="note">
        <ref name="PresentationAttributes" />
        <attribute name="style">
          <choice>
            <value>x</value>
            <value>ex</value>
          </choice>
        </attribute>
        <attribute name="caller" />
        <oneOrMore>
          <choice>
            <ref name="CrossReferenceChar" />
            <text />
          </choice>
        </oneOrMore>
      </element>
    </define>
    <define name="CrossReferenceChar">
      <element name="char">
        <ref name="PresentationAttributes" />
        <attribute name="style">
          <ref name="CrossReferenceChar.char.style.enum" />
        </attribute>
        <optional>
          <ref name="char.link" />
        </optional>
        <optional>
          <ref name="char.closed" />
        </optional>
        <oneOrMore>
          <choice>
            <ref name="Char" />
            <ref name="CrossReferenceChar" />
            <ref name="Reference" />
            <text />
          </choice>
        </oneOrMore>
      </element>
    </define>
    <define name="Sidebar">
      <element name="sidebar">
        <ref name="PresentationAttributes" />
        <attribute name="style">
          <value>esb</value>
        </attribute>
        <optional>
          <attribute name="category" />
        </optional>
        <oneOrMore>
          <choice>
            <ref name="Para" />
            <ref name="List" />
            <ref name="Table" />
            <ref name="Footnote" />
            <ref name="CrossReference" />
          </choice>
        </oneOrMore>
      </element>
    </define>
    <define name="Break">
      <element name="optbreak">
        <ref name="PresentationAttributes" />
        <empty />
      </element>
    </define>
    <define name="OtherAttributes">
      <oneOrMore>
        <attribute>
          <nsName ns="">
            <except>
              <name ns="">style</name>
              <name ns="">closed</name>
              <name ns="">link-href</name>
              <name ns="">link-title</name>
              <name ns="">link-id</name>
              <name ns="">lemma</name>
              <name ns="">strong</name>
              <name ns="">srcloc</name>
              <name ns="">gloss</name>
            </except>
          </nsName>
          <data type="string" />
        </attribute>
      </oneOrMore>
    </define>
  </include>
  <define name="NonemptyToken">
    <data type="token">
      <param name="minLength">1</param>
      <param name="pattern">[^\s]+</param>
    </data>
  </define>
  <define name="Document">
    <element name="document" ns="urn:corpora:usx-extension:0.1">
      <attribute name="version">
        <choice>
          <value>0.1.0</value>
        </choice>
      </attribute>
      <attribute name="id">
        <ref name="NonemptyToken" />
      </attribute>
      <attribute name="type">
        <choice>
          <value>document</value>
          <value>letter</value>
          <value>book</value>
          <value>booklet</value>
          <value>paper</value>
          <value>scripture</value>
        </choice>
      </attribute>
      <optional>
        <attribute name="profile">
          <ref name="NonemptyToken" />
        </attribute>
      </optional>
      <optional>
        <attribute name="work">
          <ref name="NonemptyToken" />
        </attribute>
      </optional>
      <optional>
        <attribute name="edition">
          <ref name="NonemptyToken" />
        </attribute>
      </optional>
      <optional>
        <attribute name="reading">
          <ref name="NonemptyToken" />
        </attribute>
      </optional>
      <optional>
        <attribute name="numbering">
          <ref name="NonemptyToken" />
        </attribute>
      </optional>
      <optional>
        <attribute name="lang">
          <ref name="NonemptyToken" />
        </attribute>
      </optional>
      <optional>
        <attribute name="dir">
          <choice>
            <value>ltr</value>
            <value>rtl</value>
          </choice>
        </attribute>
      </optional>
      <ref name="Title" />
      <optional>
        <ref name="Metadata" />
      </optional>
      <oneOrMore>
        <ref name="Block" />
      </oneOrMore>
    </element>
  </define>
  <define name="Title">
    <element name="title" ns="urn:corpora:usx-extension:0.1">
      <text />
    </element>
  </define>
  <define name="Metadata">
    <element name="metadata" ns="urn:corpora:usx-extension:0.1">
      <oneOrMore>
        <ref name="Meta" />
      </oneOrMore>
    </element>
  </define>
  <define name="Meta">
    <element name="meta" ns="urn:corpora:usx-extension:0.1">
      <attribute name="name">
        <ref name="NonemptyToken" />
      </attribute>
      <text />
    </element>
  </define>
  <define name="Block">
    <choice>
      <ref name="BookHeaders" />
      <ref name="BookTitles" />
      <ref name="BookIntroduction" />
      <ref name="BookIntroductionEndTitles" />
      <ref name="BookChapterLabel" />
      <ref name="ChapterContent" />
    </choice>
  </define>
  <define name="Boundary">
    <element name="boundary" ns="urn:corpora:usx-extension:0.1">
      <ref name="PresentationAttributes" />
      <attribute name="unit">
        <choice>
          <value>line</value>
          <value>section</value>
          <value>juz</value>
          <value>hizb</value>
          <value>rub</value>
          <value>manzil</value>
          <value>ruku</value>
          <value>word</value>
          <value>clause</value>
          <value>sentence</value>
          <value>paragraph</value>
        </choice>
      </attribute>
      <attribute name="scheme">
        <ref name="NonemptyToken" />
      </attribute>
      <choice>
        <group>
          <attribute name="sid">
            <ref name="NonemptyToken" />
          </attribute>
          <attribute name="label">
            <ref name="NonemptyText" />
          </attribute>
          <optional>
            <attribute name="fragment">
              <choice>
                <value>whole</value>
                <value>start</value>
                <value>middle</value>
                <value>end</value>
              </choice>
            </attribute>
          </optional>
        </group>
        <group>
          <attribute name="eid">
            <ref name="NonemptyToken" />
          </attribute>
        </group>
      </choice>
      <empty />
    </element>
  </define>
  <define name="Mark">
    <element name="mark" ns="urn:corpora:usx-extension:0.1">
      <attribute name="type">
        <choice>
          <value>sajda</value>
          <value>waqf</value>
        </choice>
      </attribute>
      <attribute name="scheme">
        <ref name="NonemptyToken" />
      </attribute>
      <attribute name="id">
        <ref name="NonemptyToken" />
      </attribute>
      <optional>
        <attribute name="label">
          <ref name="NonemptyText" />
        </attribute>
      </optional>
      <empty />
    </element>
  </define>
  <define name="Collection">
    <element name="collection" ns="urn:corpora:usx-extension:0.1">
      <attribute name="version">
        <choice>
          <value>0.1.0</value>
        </choice>
      </attribute>
      <attribute name="id">
        <ref name="NonemptyToken" />
      </attribute>
      <attribute name="kind">
        <choice>
          <value>canon</value>
          <value>corpus</value>
          <value>anthology</value>
        </choice>
      </attribute>
      <optional>
        <attribute name="profile">
          <ref name="NonemptyToken" />
        </attribute>
      </optional>
      <ref name="Title" />
      <oneOrMore>
        <choice>
          <ref name="Item" />
          <ref name="Group" />
        </choice>
      </oneOrMore>
    </element>
  </define>
  <define name="Group">
    <element name="group" ns="urn:corpora:usx-extension:0.1">
      <attribute name="id">
        <ref name="NonemptyToken" />
      </attribute>
      <attribute name="label">
        <ref name="NonemptyText" />
      </attribute>
      <oneOrMore>
        <choice>
          <ref name="Item" />
          <ref name="Group" />
        </choice>
      </oneOrMore>
    </element>
  </define>
  <define name="Item">
    <element name="item" ns="urn:corpora:usx-extension:0.1">
      <attribute name="id">
        <ref name="NonemptyToken" />
      </attribute>
      <attribute name="href">
        <ref name="NonemptyToken" />
      </attribute>
      <optional>
        <attribute name="label">
          <ref name="NonemptyText" />
        </attribute>
      </optional>
      <empty />
    </element>
  </define>
  <define name="NonemptyText">
    <data type="string">
      <param name="minLength">1</param>
    </data>
  </define>
  <define name="PresentationAttributes">
    <interleave>
      <optional>
        <attribute name="semantic" ns="urn:corpora:usx-extension:0.1">
          <choice>
            <value>h1</value>
            <value>h2</value>
            <value>h3</value>
            <value>h4</value>
            <value>h5</value>
            <value>h6</value>
            <value>paragraph</value>
            <value>link</value>
            <value>bold</value>
            <value>italic</value>
            <value>superscript</value>
            <value>footnote</value>
            <value>reference</value>
            <value>section</value>
            <value>chapter</value>
            <value>verse</value>
            <value>word</value>
            <value>clause</value>
            <value>sentence</value>
            <value>table</value>
            <value>row</value>
            <value>cell</value>
            <value>figure</value>
            <value>text</value>
            <value>anchor</value>
            <value>break</value>
            <value>title</value>
            <value>sidebar</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="node-type" ns="urn:corpora:usx-extension:0.1">
          <choice>
            <value>word</value>
            <value>clause</value>
            <value>sentence</value>
            <value>verse</value>
            <value>paragraph</value>
            <value>section</value>
            <value>chapter</value>
            <value>document</value>
            <value>book</value>
            <value>note</value>
            <value>link</value>
            <value>heading</value>
            <value>text</value>
            <value>point</value>
            <value>table</value>
            <value>row</value>
            <value>cell</value>
            <value>figure</value>
            <value>sidebar</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="style-id" ns="urn:corpora:usx-extension:0.1">
          <ref name="NonemptyToken" />
        </attribute>
      </optional>
      <optional>
        <attribute name="id" ns="urn:corpora:usx-extension:0.1">
          <ref name="NonemptyToken" />
        </attribute>
      </optional>
    </interleave>
  </define>
</grammar>
