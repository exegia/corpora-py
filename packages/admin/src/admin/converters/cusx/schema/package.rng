<?xml version='1.0' encoding='utf-8'?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0" ns="" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <start>
    <choice>
      <ref name="PackageMetadata" />
      <ref name="PackageLicense" />
      <ref name="PackageStyles" />
    </choice>
  </start>
  <define name="PackageMetadata">
    <element name="CorporaMetadata">
      <attribute name="version">
        <data type="string" />
      </attribute>
      <attribute name="id">
        <data type="string" />
      </attribute>
      <attribute name="revision">
        <data type="string" />
      </attribute>
      <interleave>
        <element name="identification">
          <element name="name">
            <text />
          </element>
          <zeroOrMore>
            <choice>
              <element name="nameLocal">
                <text />
              </element>
              <element name="description">
                <text />
              </element>
              <element name="descriptionLocal">
                <text />
              </element>
              <element name="abbreviation">
                <text />
              </element>
              <element name="abbreviationLocal">
                <text />
              </element>
              <element name="scope">
                <text />
              </element>
              <element name="dateCompleted">
                <text />
              </element>
            </choice>
          </zeroOrMore>
        </element>
        <element name="type">
          <element name="medium">
            <text />
          </element>
          <element name="documentType">
            <text />
          </element>
          <element name="hasCharacters">
            <text />
          </element>
        </element>
        <element name="language">
          <oneOrMore>
            <choice>
              <element name="iso">
                <text />
              </element>
              <element name="name">
                <text />
              </element>
              <element name="nameLocal">
                <text />
              </element>
              <element name="script">
                <text />
              </element>
              <element name="scriptCode">
                <text />
              </element>
              <element name="scriptDirection">
                <text />
              </element>
              <element name="ldml">
                <text />
              </element>
              <element name="numerals">
                <text />
              </element>
            </choice>
          </oneOrMore>
        </element>
        <element name="format">
          <element name="usxVersion">
            <text />
          </element>
          <element name="corporaVersion">
            <text />
          </element>
          <element name="versedParagraphs">
            <data type="boolean" />
          </element>
        </element>
        <element name="names">
          <oneOrMore>
            <element name="name">
              <attribute name="id">
                <data type="string" />
              </attribute>
              <element name="abbr">
                <text />
              </element>
              <element name="short">
                <text />
              </element>
              <element name="long">
                <text />
              </element>
            </element>
          </oneOrMore>
        </element>
        <element name="manifest">
          <oneOrMore>
            <element name="resource">
              <attribute name="checksum">
                <data type="string" />
              </attribute>
              <optional>
                <attribute name="checksumAlgorithm">
                  <data type="string" />
                </attribute>
              </optional>
              <attribute name="mimeType">
                <data type="string" />
              </attribute>
              <attribute name="size">
                <data type="nonNegativeInteger" />
              </attribute>
              <attribute name="uri">
                <data type="string" />
              </attribute>
            </element>
          </oneOrMore>
        </element>
        <element name="source">
          <optional>
            <ref name="CanonicalContent" />
          </optional>
          <ref name="PackageStructure" />
        </element>
        <element name="publications">
          <oneOrMore>
            <element name="publication">
              <attribute name="id">
                <data type="string" />
              </attribute>
              <optional>
                <attribute name="default">
                  <data type="boolean" />
                </attribute>
              </optional>
              <element name="name">
                <text />
              </element>
              <zeroOrMore>
                <choice>
                  <element name="nameLocal">
                    <text />
                  </element>
                  <element name="description">
                    <text />
                  </element>
                  <element name="descriptionLocal">
                    <text />
                  </element>
                  <element name="abbreviation">
                    <text />
                  </element>
                  <element name="abbreviationLocal">
                    <text />
                  </element>
                  <element name="publisher">
                    <text />
                  </element>
                  <element name="creator">
                    <text />
                  </element>
                  <element name="identifier">
                    <text />
                  </element>
                  <element name="subject">
                    <text />
                  </element>
                  <element name="datePublished">
                    <text />
                  </element>
                </choice>
              </zeroOrMore>
              <optional>
                <ref name="CanonicalContent" />
              </optional>
              <ref name="PackageStructure" />
            </element>
          </oneOrMore>
        </element>
        <optional>
          <element name="copyright">
            <element name="fullStatement">
              <element name="statementContent">
                <attribute name="type">
                  <data type="string" />
                </attribute>
                <oneOrMore>
                  <ref name="RichText" />
                </oneOrMore>
              </element>
            </element>
          </element>
        </optional>
        <optional>
          <element name="promotion">
            <zeroOrMore>
              <ref name="DescriptiveField" />
            </zeroOrMore>
          </element>
        </optional>
        <optional>
          <element name="archiveStatus">
            <zeroOrMore>
              <ref name="DescriptiveField" />
            </zeroOrMore>
          </element>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="CanonicalContent">
    <element name="canonicalContent">
      <oneOrMore>
        <element name="book">
          <attribute name="code">
            <data type="string" />
          </attribute>
        </element>
      </oneOrMore>
    </element>
  </define>
  <define name="PackageStructure">
    <element name="structure">
      <oneOrMore>
        <ref name="PackageContent" />
      </oneOrMore>
    </element>
  </define>
  <define name="PackageContent">
    <element name="content">
      <attribute name="name">
        <data type="string" />
      </attribute>
      <attribute name="src">
        <data type="string" />
      </attribute>
      <attribute name="role">
        <data type="string" />
      </attribute>
      <zeroOrMore>
        <ref name="PackageContent" />
      </zeroOrMore>
    </element>
  </define>
  <define name="PackageLicense">
    <element name="license">
      <attribute name="id">
        <data type="string" />
      </attribute>
      <optional>
        <attribute name="profile">
          <data type="string" />
        </attribute>
      </optional>
      <optional>
        <element name="dateLicense">
          <text />
        </element>
      </optional>
      <optional>
        <element name="accessType">
          <text />
        </element>
      </optional>
      <oneOrMore>
        <element name="statement">
          <text />
        </element>
      </oneOrMore>
      <element name="publicationRights">
        <attribute name="status">
          <data type="string" />
        </attribute>
        <zeroOrMore>
          <choice>
            <element name="allowIntroductions">
              <text />
            </element>
            <element name="allowFootnotes">
              <text />
            </element>
            <element name="allowCrossReferences">
              <text />
            </element>
            <element name="allowExtendedNotes">
              <text />
            </element>
          </choice>
        </zeroOrMore>
      </element>
      <optional>
        <element name="permissionContact">
          <text />
        </element>
      </optional>
    </element>
  </define>
  <define name="PackageStyles">
    <element name="stylesheet">
      <optional>
        <attribute name="version">
          <data type="string" />
        </attribute>
      </optional>
      <optional>
        <attribute name="profile">
          <data type="string" />
        </attribute>
      </optional>
      <zeroOrMore>
        <ref name="StyleProperty" />
      </zeroOrMore>
      <oneOrMore>
        <element name="style">
          <attribute name="id">
            <data type="string" />
          </attribute>
          <attribute name="publishable">
            <data type="boolean" />
          </attribute>
          <attribute name="versetext">
            <data type="boolean" />
          </attribute>
          <optional>
            <attribute name="semantic">
              <data type="string" />
            </attribute>
          </optional>
          <optional>
            <attribute name="nodeType">
              <data type="string" />
            </attribute>
          </optional>
          <element name="name">
            <text />
          </element>
          <element name="description">
            <text />
          </element>
          <zeroOrMore>
            <ref name="StyleProperty" />
          </zeroOrMore>
        </element>
      </oneOrMore>
    </element>
  </define>
  <define name="StyleProperty">
    <element name="property">
      <attribute name="name">
        <data type="string" />
      </attribute>
      <optional>
        <attribute name="unit">
          <data type="string" />
        </attribute>
      </optional>
      <optional>
        <attribute name="state">
          <data type="string" />
        </attribute>
      </optional>
      <text />
    </element>
  </define>
  <define name="RichText">
    <choice>
      <element name="p">
        <optional>
          <attribute name="href">
            <data type="string" />
          </attribute>
        </optional>
        <zeroOrMore>
          <ref name="RichText" />
        </zeroOrMore>
        <text />
      </element>
      <element name="span">
        <optional>
          <attribute name="href">
            <data type="string" />
          </attribute>
        </optional>
        <zeroOrMore>
          <ref name="RichText" />
        </zeroOrMore>
        <text />
      </element>
      <element name="a">
        <optional>
          <attribute name="href">
            <data type="string" />
          </attribute>
        </optional>
        <zeroOrMore>
          <ref name="RichText" />
        </zeroOrMore>
        <text />
      </element>
    </choice>
  </define>
  <define name="DescriptiveField">
    <element>
      <anyName />
      <zeroOrMore>
        <attribute>
          <anyName />
          <text />
        </attribute>
      </zeroOrMore>
      <zeroOrMore>
        <choice>
          <ref name="DescriptiveField" />
          <text />
        </choice>
      </zeroOrMore>
    </element>
  </define>
</grammar>
