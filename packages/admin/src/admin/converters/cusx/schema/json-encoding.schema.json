{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corpora USX 0.1.0 canonical ordered XML JSON encoding",
  "description": "Wire shape only. Decode and validate the document with corpora.rng and the semantic checker. Omit content for empty elements.",
  "$ref": "#/$defs/element",
  "$defs": {
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "namespace",
        "attributes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "[^\\S ]| {2}"
                }
              },
              {
                "$ref": "#/$defs/element"
              }
            ]
          },
          "contains": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "string",
                "pattern": "\\S"
              }
            ]
          }
        }
      }
    }
  }
}
