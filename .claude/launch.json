{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "corpora-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "corpora-api"],
      "port": 8000
    },
    {
      "name": "corpora-api-noauth",
      "runtimeExecutable": "env",
      "runtimeArgs": ["AUTH_REQUIRED=false", "uv", "run", "corpora-api"],
      "port": 8000
    },
    {
      "name": "example-app",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--cwd", "example", "vite:dev"],
      "port": 5173
    },
    {
      "name": "cf-mcp-sse",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "cf-mcp",
        "--corpus",
        "~/.exegia/datasets/bibles/BHSA",
        "--name",
        "BHSA",
        "--sse",
        "8001"
      ],
      "port": 8001
    }
  ]
}
