{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "uv sync --active --frozen --no-dev --no-editable",
  "functions": {
    "src/corpora_py/app.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,docs/**,example/**,dockerfiles/**,bin/**,scripts/**,daily/**,dist/**,.github/**,**/CLAUDE.md,**/*.md,**/__pycache__/**,**/*.pyc,uv.lock,makefile,skills-lock.json,LICENSE,SECURITY.md}"
    }
  }
}
