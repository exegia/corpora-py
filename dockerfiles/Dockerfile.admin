# Dockerfile.admin
# Full-featured container for corpus conversion / admin tools.
# Includes corpora-admin with text-fabric, EPUB/HTML/PDF/TEI converters, etc.
#
# Build:
#   docker build -f Dockerfile.admin -t corpora-admin .
#
# Run:
#   docker run -it \
#     -e ENVIRONMENT=production \
#     -e PROJECT_REF=<your-supabase-ref> \
#     -e SUPABASE_SECRET_KEY=<key> \
#     -v ~/.exegia/datasets:/data/datasets \
#     -v ~/my-epub-sources:/data/sources:ro \
#     corpora-admin \
#     python -c "from admin.converters import convert_epub_to_tf; convert_epub_to_tf('/data/sources/book.epub', '/data/datasets/output')"

# ── Stage 1: install dependencies into a virtual environment ─────────────────
FROM python:3.13-slim AS builder

# Install uv + build tools (text-fabric may need Cython / gcc)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace root + all packages (admin depends on common)
COPY pyproject.toml uv.lock* ./
COPY packages/common packages/common
COPY packages/admin  packages/admin

# Build wheels
RUN uv build --package corpora-common --wheel --out-dir /wheels/ && \
    uv build --package corpora-admin  --wheel --out-dir /wheels/

# Install into a dedicated venv (text-fabric is a direct dependency of
# corpora-admin, not gated behind an extra)
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir --find-links /wheels \
        corpora-admin

# ── Stage 2: runtime image ────────────────────────────────────────────────────
FROM python:3.13-slim

LABEL org.opencontainers.image.title="corpora-admin" \
      org.opencontainers.image.description="Corpora admin and corpus conversion tools" \
      org.opencontainers.image.source="https://github.com/exegia/corpora-py"

# Runtime deps for lxml / beautifulsoup4
RUN apt-get update && apt-get install -y --no-install-recommends \
    libxml2 \
    libxslt1.1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ENVIRONMENT=production

VOLUME ["/data/datasets", "/data/sources"]

# Default: show available admin modules
CMD ["python", "-c", "import admin; print('corpora-admin ready. Available: admin.parsers.*, admin.converters.*')"]
