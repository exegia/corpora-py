{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:corpora:corpus-document:0.4.0:ingestion-decision.schema.json",
  "title": "PDF ingestion quality/acceptance decision",
  "type": "object",
  "properties": {
    "specVersion": {
      "const": "0.4.0"
    },
    "policyId": {
      "const": "urn:corpora:pdf-acceptance:0.4.0"
    },
    "format": {
      "const": "pdf"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourcePageCount": {
      "type": "integer",
      "minimum": 0
    },
    "scope": {
      "enum": [
        "whole-document",
        "bounded-sample"
      ]
    },
    "ocrUsed": {
      "type": "boolean"
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pageIndex": {
            "type": "integer",
            "minimum": 0
          },
          "content": {
            "enum": [
              "satisfactory",
              "blank-confirmed",
              "unreadable",
              "unverified"
            ]
          },
          "readingOrder": {
            "enum": [
              "satisfactory",
              "material-failure",
              "unverified"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "pageIndex",
          "content",
          "readingOrder",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "accepted",
        "rejected",
        "pending-review"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "pageIndex": {
            "type": "integer",
            "minimum": 0
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "extractionFailed": {
      "type": "boolean"
    },
    "candidateSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "specVersion",
    "policyId",
    "format",
    "sourceSha256",
    "sourcePageCount",
    "scope",
    "ocrUsed",
    "assessments",
    "status",
    "issues",
    "extractionFailed",
    "candidateSha256"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "properties": {
          "scope": {
            "const": "whole-document"
          },
          "extractionFailed": {
            "const": false
          },
          "sourcePageCount": {
            "minimum": 1
          },
          "issues": {
            "maxItems": 0
          },
          "assessments": {
            "minItems": 1
          },
          "candidateSha256": {
            "type": "string"
          }
        }
      }
    }
  ]
}
